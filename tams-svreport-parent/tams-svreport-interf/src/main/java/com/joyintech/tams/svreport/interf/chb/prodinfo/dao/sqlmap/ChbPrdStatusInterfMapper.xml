<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="com.joyintech.tams.svreport.interf.chb.prodinfo.dao.ChbPrdStatusInterfMapper">
	<resultMap id="BaseResultMap"
		type="com.joyintech.tams.common.base.entity.ChbPrdStatusGd">
		<result column="UUID" property="uuid" jdbcType="CHAR" />
		<result column="ISSUE_PARTY_ID" property="issuePartyId" jdbcType="VARCHAR" />
		<result column="POS_DATE" property="posDate" jdbcType="DATE" />
		<result column="PROD_ID" property="prodId" jdbcType="VARCHAR" />
		<result column="N_HLDMKV_LOCAL_ZCHJ" property="nHldmkvLocalZchj" jdbcType="DECIMAL" />
		<result column="N_HLDMKV_LOCAL_ZCJZ" property="nHldmkvLocalZcjz" jdbcType="DECIMAL" />
		<result column="STATUS" property="status" jdbcType="VARCHAR" />
		<result column="ORG_CODE" property="orgCode" jdbcType="VARCHAR" />
		<result column="DEPT_CODE" property="deptCode" jdbcType="VARCHAR" />
		<result column="CREATE_USER" property="createUser" jdbcType="VARCHAR" />
		<result column="CREATE_DEPT" property="createDept" jdbcType="VARCHAR" />
		<result column="CREATE_TIME" property="createTime" jdbcType="TIMESTAMP" />
		<result column="UPDATE_USER" property="updateUser" jdbcType="VARCHAR" />
		<result column="UPDATE_TIME" property="updateTime" jdbcType="TIMESTAMP" />

	</resultMap>

	<insert id="insertBatchList" parameterType="com.joyintech.tams.common.base.entity.ChbPrdStatusGd" >
        insert into CHB_PRD_STATUS_GD (UUID, ISSUE_PARTY_ID, POS_DATE,
            PROD_ID, N_HLDMKV_LOCAL_ZCHJ, N_HLDMKV_LOCAL_ZCJZ,
            STATUS, ORG_CODE, DEPT_CODE,
            CREATE_USER, CREATE_DEPT, CREATE_TIME,
            UPDATE_USER, UPDATE_TIME)VALUES
		<foreach collection="list" item="dto" separator=",">
			(uuid(), #{dto.issuePartyId,jdbcType=VARCHAR}, #{dto.posDate,jdbcType=DATE},
			#{dto.prodId,jdbcType=VARCHAR}, #{dto.nHldmkvLocalZchj,jdbcType=DECIMAL}, #{dto.nHldmkvLocalZcjz,jdbcType=DECIMAL},
			#{dto.status,jdbcType=VARCHAR}, #{dto.orgCode,jdbcType=VARCHAR}, #{dto.deptCode,jdbcType=VARCHAR},
			#{dto.createUser,jdbcType=VARCHAR}, #{dto.createDept,jdbcType=VARCHAR}, #{dto.createTime,jdbcType=TIMESTAMP},
			#{dto.updateUser,jdbcType=VARCHAR}, #{dto.updateTime,jdbcType=TIMESTAMP})
		</foreach>

    </insert>

	<delete id="deleteByDate" parameterType="date" >
		delete from CHB_PRD_STATUS_GD
		where POS_DATE<![CDATA[=]]> #{date,jdbcType=DATE}
  </delete>
</mapper>